# Image generation through Gemini (server only)
GEMINI_API_KEY=your_gemini_api_key_here

# Lumina Assistant
# Supported values: openai-compatible, gemini, anthropic
AI_PROVIDER=openai-compatible
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-5-mini
AI_BASE_URL=https://api.openai.com/v1

# Optional branding headers used by providers such as OpenRouter
AI_APP_NAME=Lumina AI
AI_SITE_URL=http://localhost:5173

# Optional custom system instruction
# AI_SYSTEM_PROMPT=You are the helpful Lumina AI assistant.

# Other examples:
# Google Gemini:
# AI_PROVIDER=gemini
# AI_API_KEY=your_gemini_api_key_here
# AI_MODEL=gemini-2.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Anthropic Claude:
# AI_PROVIDER=anthropic
# AI_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-sonnet-4-5
# AI_BASE_URL=https://api.anthropic.com/v1
#
# OpenRouter:
# AI_PROVIDER=openai-compatible
# AI_API_KEY=your_openrouter_api_key_here
# AI_MODEL=openai/gpt-5-mini
# AI_BASE_URL=https://openrouter.ai/api/v1
